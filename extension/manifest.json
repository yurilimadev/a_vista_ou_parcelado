{
  "manifest_version": 3,
  "name": "À Vista ou Parcelado?",
  "version": "1.0",
  "description": "Analisa a melhor forma de pagamento em páginas de e-commerce.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "host_permissions": [
    "http://localhost:8000/*" 
  ]
}
